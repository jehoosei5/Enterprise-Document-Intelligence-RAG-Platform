# Copy this file to .env and fill in real values. .env is git-ignored.

# ---- Azure OpenAI ----
# Resource endpoint, e.g. https://my-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment names (these are YOUR deployment names in Azure, not model names)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072

# ---- Qdrant Cloud ----
# Cluster URL, e.g. https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=doc-intel-rag

# ---- Cohere (reranker, added in v2) ----
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# ---- MySQL (Railway) — app data: users, documents, permissions, eval logs ----
# From the Railway MySQL plugin's "Connect" tab. Note the driver prefix:
# Railway gives you mysql://..., change it to mysql+pymysql://... for SQLAlchemy.
DATABASE_URL=mysql+pymysql://<user>:<password>@<host>.railway.app:<port>/railway

# ---- Auth (added in v3) ----
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---- App ----
APP_ENV=development
UPLOAD_DIR=./data/uploads
LOG_LEVEL=INFO
