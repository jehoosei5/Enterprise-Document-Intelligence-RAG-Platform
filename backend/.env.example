# Copy this file to .env (same folder) and fill in real values. .env is git-ignored.

# ---- Azure OpenAI ----
# Resource endpoint, e.g. https://my-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment names (these are YOUR deployment names in Azure, not model names)
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072

# ---- Qdrant Cloud ----
# Cluster URL, e.g. https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=doc-intel-rag

# ---- Cohere (reranker, added in v2) ----
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5

# ---- MySQL — app data: users, documents, permissions, eval logs ----
# Local dev: point at your local MySQL install (create the DB first:
# `CREATE DATABASE ragdb;`).
# Deployed on Railway: the backend service's Railway env vars should instead
# reference the MySQL plugin's internal URL (e.g. `${{MySQL.MYSQL_URL}}`,
# rewritten to the mysql+pymysql:// scheme) — mysql.railway.internal only
# resolves from inside Railway's private network, not from your machine.
DATABASE_URL=mysql+pymysql://root:<your-local-mysql-password>@localhost:3306/ragdb

# ---- Auth ----
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---- Google sign-in ----
# OAuth Client ID from Google Cloud Console (Web application type). No
# client secret needed — the backend only verifies client-obtained ID
# tokens, it doesn't do a server-side OAuth code exchange.
GOOGLE_CLIENT_ID=

# ---- Password reset (Resend) ----
# https://resend.com — without a verified sending domain, mail can only be
# delivered to the Resend account's own signup address (sandbox limit).
RESEND_API_KEY=
RESEND_FROM_EMAIL=DocIntel <onboarding@resend.dev>
# Base URL of the deployed frontend — used to build the reset-password link.
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30

# ---- App ----
APP_ENV=development
UPLOAD_DIR=./data/uploads
LOG_LEVEL=INFO
