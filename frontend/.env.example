# Copy to .env.local (git-ignored) and fill in real values.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# Google OAuth Client ID (same one used on the backend for GOOGLE_CLIENT_ID —
# Client IDs aren't secret, safe to ship in frontend code). Must have
# http://localhost:5173 (and your deployed frontend origin) added under
# "Authorized JavaScript origins" in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=
